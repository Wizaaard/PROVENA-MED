    {"id": "B6-CIPROFLOXACIN", "category": "renal_dose", "members": ["ciprofloxacin"], "egfr_lt": 30, "action": "caution", "age_min": 65, "message": "Reduce ciprofloxacin dose if CrCl < 30 (CNS effects, tendon rupture).", "source": "Beers 2023, Table 6"},
