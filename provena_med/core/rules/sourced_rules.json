  },
  "rules": [
    {"id": "PH3-AMPHET-MAOI", "category": "ddi", "action": "contraindicated",
     "members_a": ["dexmethylphenidate","dextroamphetamine","methylphenidate","lisdexamfetamine","methamphetamine","phendimetrazine","pseudoephedrine","amphetamine","benzphetamine","diethylpropion","phentermine","atomoxetine"],
     "members_b": ["tranylcypromine","phenelzine","isocarboxazid","procarbazine","selegiline","rasagiline","moclobemide","methylene blue",{"atc":"maoi"}],
     "message": "Amphetamines/sympathomimetics + MAO inhibitors: hypertensive crisis.",
     "source": "Phansalkar 2012, JAMIA, Table 2, DDI #3"},

    {"id": "PH4-ATAZANAVIR-PPI", "category": "ddi", "action": "contraindicated",
     "members_a": ["atazanavir"],
     "members_b": ["omeprazole","lansoprazole","pantoprazole","rabeprazole","esomeprazole","dexlansoprazole"],
     "message": "Atazanavir + PPI: reduced atazanavir absorption/efficacy.",
     "source": "Phansalkar 2012, Table 2, DDI #4"},

    {"id": "PH6-FEBUXOSTAT-AZA", "category": "ddi", "action": "contraindicated",
     "members_a": ["febuxostat"],
     "members_b": ["azathioprine","mercaptopurine"],
     "message": "Febuxostat + azathioprine/mercaptopurine: severe myelosuppression.",
     "source": "Phansalkar 2012, Table 2, DDI #6"},

    {"id": "PH8-SSRI-MAOI", "category": "ddi", "action": "contraindicated",
