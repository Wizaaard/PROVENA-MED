    {"id": "B6-DABIGATRAN", "category": "renal_dose", "members": ["dabigatran"], "egfr_lt": 30, "action": "contraindicated", "age_min": 65, "message": "Avoid dabigatran if CrCl < 30.", "source": "Beers 2023, Table 6"},
